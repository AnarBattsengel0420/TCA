def _score_all_files(store, question: str, expansions: list, ollama_kws: list = None) -> list:
    if not store or not store.chunks:
        return []

    q_lower = question.lower()
    q_words = [w for w in re.findall(r"\w+", q_lower, re.UNICODE)
               if len(w) >= 2 and w not in _FNAME_STOP]
    kw_terms = _build_keyword_fallback_terms(question, expansions, ollama_kws or [])

    _domain_set = set(_ABBR.keys()) | set(_DOMAIN_EXPAND.keys())
    strong_pool = [w for w in q_words if w in _domain_set or len(w) >= 5 or any(ch.isdigit() for ch in w)]
    if ollama_kws:
        for kw in ollama_kws:
            kl = kw.lower().strip()
            if kl and kl not in strong_pool:
                strong_pool.append(kl)

    bm25_queries = _build_bm25_queries(question, expansions, ollama_kws or [])

    bm25_raw: dict[int, float] = {}
    for bq in bm25_queries:
        for idx, sc in store.bm25.search(bq, top_k=len(store.chunks)):
            bm25_raw[idx] = max(bm25_raw.get(idx, 0.0), sc)
    bmx = max(bm25_raw.values(), default=1e-9)

    file_scores: dict[str, dict] = {}
    for idx, ch in enumerate(store.chunks):
        src     = ch.get("source", "?")
        raw_txt = ch.get("text", "")
        txt     = raw_txt.lower()

        b_norm  = bm25_raw.get(idx, 0.0) / bmx
        kw_hits = sum(1 for w in kw_terms if len(w) >= 3 and w in txt)
        kw_norm = min(kw_hits / max(min(len(kw_terms), 4), 1), 1.0)
        frel    = _file_relevance_score(ch, question, expansions)

        if strong_pool:
            pool_hits = [w for w in strong_pool if w in txt]
            strong_score = min(0.40 + (len(pool_hits) - 1) * 0.10, 0.95) if pool_hits else 0.0
        else:
            strong_score = kw_norm * 0.5 if kw_norm >= 0.5 else 0.0

        combined_base = BM25_WEIGHT * b_norm + VECTOR_WEIGHT * kw_norm + frel * 0.3
        combined = max(strong_score, combined_base)

        if src not in file_scores or combined > file_scores[src]["score"]:
            file_scores[src] = {
                "score":  combined,
                "bm25":   b_norm,
                "kw":     kw_norm,
                "frel":   frel,
                "sample": raw_txt[:60].replace("\n", " "),
            }

    ranked = sorted(file_scores.items(), key=lambda x: x[1]["score"], reverse=True)
    return [(src, v["score"], v["bm25"], v["kw"], v["frel"], v["sample"])
            for src, v in ranked]


def answer_stream(question, model, top_k, use_reranker, debug_mode, history):
    if not question.strip(): yield history; return
    if store is None or store.faiss_idx is None:
        yield _chat_append(history, question, "⚠️ Эхлээд индекс ачааллана уу!"); return

    t_start = time.perf_counter()

    use_advanced = bool(model and model != "(олдсонгүй)")

    if use_advanced:
        results, search_meta = enhanced_search_pipeline(
            store, question, model, int(top_k),
            use_reranker, bool(debug_mode)
        )
    else:
        results = store.search(question, top_k=int(top_k),
                               use_reranker=use_reranker, debug=bool(debug_mode))
        search_meta = {"query_type": "mixed", "sub_queries": [], "enhanced": "", "weights": {}}

    t_search = time.perf_counter() - t_start

    if not results:
        yield _chat_append(history, question,
            "🔍 Мэдээлэл олдсонгүй.\n"
            "- Өөр үгээр асуугаарай\n- Top-K нэмнэ үү\n- Debug горим асаагаарай")
        return

