_find_ollama_cache = None
def _find_ollama():
    global _find_ollama_cache
    if _find_ollama_cache is not None:
        return _find_ollama_cache or None
    p = shutil.which("ollama")
    if p: _find_ollama_cache = p; return p
    if sys.platform == "win32":
        for c in [Path(os.environ.get("LOCALAPPDATA",""))/"Programs/Ollama/ollama.exe",
                  Path.home()/"AppData/Local/Programs/Ollama/ollama.exe"]:
            if c.exists(): _find_ollama_cache = str(c); return str(c)
    _find_ollama_cache = ""
    return None

_ping_cache = {"ok": None, "ts": 0.0}
def _ollama_ping():
    now = time.perf_counter()
    if _ping_cache["ok"] is not None and (now - _ping_cache["ts"]) < 30.0:
        return _ping_cache["ok"]
    try:
        import urllib.request
        urllib.request.urlopen(f"{OLLAMA_HOST}/api/tags", timeout=2).close()
        _ping_cache.update(ok=True, ts=now); return True
    except Exception:
        _ping_cache.update(ok=False, ts=now); return False

def get_ollama_models():
    models = []
    try:
        import ollama; r = ollama.list()
        ml = r.get("models",[]) if isinstance(r,dict) else getattr(r,"models",[]) or []
        for m in ml:
            n = m.get("model",m.get("name","")) if isinstance(m,dict) else getattr(m,"model","")
            if n: models.append(n)
        if models: return models
    except Exception: pass
    try:
        exe = _find_ollama()
        if exe:
            flags = {"creationflags":subprocess.CREATE_NO_WINDOW} if sys.platform=="win32" else {}
            r = subprocess.run([exe,"list"], capture_output=True, text=True, timeout=10, **flags)
            for line in r.stdout.strip().split("\n")[1:]:
                p = line.split()
                if p and p[0].lower() != "name": models.append(p[0])
            if models: return models
    except Exception: pass
    try:
        import urllib.request
        with urllib.request.urlopen(
            urllib.request.Request(f"{OLLAMA_HOST}/api/tags"), timeout=5) as resp:
            for m in json.loads(resp.read()).get("models",[]):
                n = m.get("model") or m.get("name","")
                if n: models.append(n)
    except Exception: pass
    return models

