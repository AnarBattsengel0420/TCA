def _sanitize_name(name):
    name = re.sub(r'[\\/:*?"<>|]', "_", name.strip())
    return re.sub(r'\s+', "_", name)[:80] or "default"

def _index_base(name):
    INDEX_DIR.mkdir(parents=True, exist_ok=True)
    return str(INDEX_DIR / _sanitize_name(name))

def list_saved_indexes():
    INDEX_DIR.mkdir(parents=True, exist_ok=True)
    return [f.stem for f in sorted(INDEX_DIR.glob("*.faiss"),
            key=lambda x: x.stat().st_mtime, reverse=True)]

def _index_info(name):
    if not name or name == "(байхгүй)": return ""
    p = Path(_index_base(name) + ".meta")
    if not p.exists(): return ""
    try:
        with open(p,"rb") as f: meta = pickle.load(f)
        n   = len(meta.get("chunks",[]))
        key = meta.get("key","?")
        fld = Path(meta.get("folder","?")).name
        sat = meta.get("saved_at","")
        ml  = " 🌐" if EMBED_MODELS.get(key,{}).get("multilingual") else ""
        return f"{n:,} chunk | {key}{ml} | {fld}" + (f" | {sat}" if sat else "")
    except Exception: return ""

def _dd_and_info(selected=None):
    saved = list_saved_indexes()
    if not saved: return gr.update(choices=["(байхгүй)"], value="(байхгүй)"), ""
    value = selected if (selected and selected in saved) else saved[0]
    return gr.update(choices=saved, value=value), _index_info(value)


