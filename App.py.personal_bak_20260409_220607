_RE_CTRL = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f-\x9f\ud800-\udfff]")
def clean_text(t): return _RE_CTRL.sub("", t) if t else ""
def safe_encode(t): return clean_text(t).encode("utf-8", errors="replace")


