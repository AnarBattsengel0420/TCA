_expand_cache: dict[str, list] = {}
_expand_cache_max = 64

def expand_query(query: str) -> list[str]:
    q_lower = query.lower().strip()
    if q_lower in _expand_cache:
        return _expand_cache[q_lower]
    result = _expand_query_impl(q_lower)
    if len(_expand_cache) >= _expand_cache_max:
        _expand_cache.clear()
    _expand_cache[q_lower] = result
    return result

def _expand_query_impl(q_lower: str) -> list[str]:
    tokens   = re.findall(r"\w+", q_lower, re.UNICODE)
    expanded = [q_lower]

    for tok in tokens:
        full = _ABBR.get(tok)
        if full and full not in expanded:
            expanded.append(full)
        full2 = _ABBR.get(tok.lower())
        if full2 and full2 not in expanded:
            expanded.append(full2)

    for tok in tokens:
        domain_terms = _DOMAIN_EXPAND.get(tok.lower())
        if domain_terms:
            for term in domain_terms:
                tl = term.lower()
                if len(term.replace(" ", "")) <= 2:
                    prefixed = f"{tok.upper()} {term}"
                    if prefixed.lower() not in [e.lower() for e in expanded]:
                        expanded.append(prefixed)
                else:
                    if tl not in [e.lower() for e in expanded]:
                        expanded.append(term)

    for i, t1 in enumerate(tokens[:-1]):
        combo_key = f"{t1} {tokens[i+1]}"
        domain_terms = _DOMAIN_EXPAND.get(combo_key)
        if domain_terms:
            for term in domain_terms:
                tl = term.lower()
                if len(term.replace(" ", "")) <= 2:
                    prefixed = f"{combo_key.upper()} {term}"
                    if prefixed.lower() not in [e.lower() for e in expanded]:
                        expanded.append(prefixed)
                elif tl not in [e.lower() for e in expanded]:
                    expanded.append(term)
        combo = _ABBR.get(combo_key)
        if combo and combo not in expanded:
            expanded.append(combo)

    if _is_personal_query(q_lower):
        _personal_extras = [
            "resume", "cv", "entry sheet", "エントリーシート",
            "履歴書", "語学", "学歴", "certificate", "qualification",
            "gpa", "grade", "level", "score", "намтар", "анкет",
        ]
        for pe in _personal_extras:
            if pe.lower() not in [e.lower() for e in expanded]:
                expanded.append(pe)

    return expanded


def _build_bm25_queries(question: str, expansions: list, extra_terms: list = None) -> set:
    stop = {
        "вэ", "бэ", "юу", "яу", "гэж", "гэх", "нь", "ын", "ийн", "бол", "байна",
        "дэх", "дотор", "the", "is", "a", "of", "and", "in", "to", "for", "with",
        "on", "at", "by", "an",
    }
    level_re = re.compile(r"^[nN]\d$")
    queries = {question}
    extra_terms = extra_terms or []

    def _add_strong_tokens(text: str):
        for tok in re.findall(r"\w+", text, re.UNICODE):
            tl = tok.lower()
            if len(tl) < 3 or tl in stop or level_re.match(tl):
                continue
            if any(ch.isdigit() for ch in tl) or len(tl) >= 5:
                queries.add(tok)

    _add_strong_tokens(question)

    for exp_q in expansions[:6]:
        toks = re.findall(r"\w+", exp_q, re.UNICODE)
        if not toks:
            continue
        if len(toks) <= 3:
            queries.add(exp_q)
        else:
            i = 0
            while i < len(toks):
                t1 = toks[i]
                t2 = toks[i + 1] if i + 1 < len(toks) else None
                if level_re.match(t1):
                    i += 1
                elif t2 and level_re.match(t2):
                    queries.add(f"{t1} {t2}")
                    i += 2
                else:
                    queries.add(f"{t1} {t2}" if t2 else t1)
                    i += 2
        _add_strong_tokens(exp_q)

    for term in extra_terms[:8]:
        term = str(term).strip()
        if len(term) >= 3:
            queries.add(term)
            _add_strong_tokens(term)

    return {q for q in queries if q and str(q).strip()}


def _build_keyword_fallback_terms(query: str, expansions: list, extra_terms: list = None) -> list:
    stop = {
        "вэ", "бэ", "юу", "яу", "гэж", "гэх", "нь", "ын", "ийн", "бол", "байна",
        "дэх", "дотор", "the", "is", "a", "of", "and", "in", "to", "for", "with",
        "on", "at", "by", "an",
    }
    extra_terms = extra_terms or []
    pool = [query] + list(expansions[:4]) + [str(x) for x in extra_terms[:8]]
    out = []
    seen = set()

    def _push(term: str):
        tl = str(term).lower().strip()
        if not tl or tl in seen:
            return
        if tl in stop:
            return
        if len(tl) >= 3 or any(ch.isdigit() for ch in tl):
            seen.add(tl)
            out.append(tl)

    for src in pool:
        _push(src)
        for tok in re.findall(r"\w+", src.lower(), re.UNICODE):
            _push(tok)
        for raw in src.lower().split():
            compact = re.sub(r"[\W_]+", "", raw, flags=re.UNICODE)
            _push(compact)

    out.sort(key=len, reverse=True)
    return out[:10]


def _chunk_key(chunk: dict, prefix_len: int = 100) -> str:
    return f"{chunk.get('source', '?')}|{chunk.get('text', '')[:prefix_len]}"


def _is_filename_like_query(query: str) -> bool:
    q = (query or "").strip()
    if not q:
        return False
    if re.search(r"[\\/]", q):
        return True
    if re.search(r"\.[a-zA-Z0-9]{1,6}\b", q):
        return True
    tokens = re.findall(r"[\w$.-]+", q, re.UNICODE)
    if "$" in q and tokens:
        return True
    if len(tokens) <= 3:
        for t in tokens:
            if any(ch.isalpha() for ch in t) and any(ch.isdigit() for ch in t) and len(t) >= 4:
                return True
    return False


def search_by_keyword(store, query: str, top_files: int = 8, chunks_per_file: int = 2) -> list:
    if not store or not getattr(store, "chunks", None):
        return []

    q = (query or "").strip().lower()
    if not q:
        return []

    terms = [q]
    for tok in re.findall(r"[\w$.-]+", q, re.UNICODE):
        t = tok.strip(" ._-")
        if len(t) >= 2 and t not in _FNAME_STOP:
            terms.append(t)
        compact = re.sub(r"[^\w]+", "", t, flags=re.UNICODE)
        if len(compact) >= 3 and compact not in _FNAME_STOP:
            terms.append(compact)

    seen_term, clean_terms = set(), []
    for t in terms:
        if t and t not in seen_term:
            seen_term.add(t)
            clean_terms.append(t)
    clean_terms = clean_terms[:12]

    by_source = {}
    for ch in store.chunks:
        src = ch.get("source", "")
        by_source.setdefault(src, []).append(ch)

    file_rank = []
    for src, chunks in by_source.items():
        src_l = _normalize_filename(src).lower()
        matched = [t for t in clean_terms if t in src_l]
        if not matched:
            continue

        ratio = len(matched) / max(len(clean_terms), 1)
        exact_bonus = 0.20 if q in src_l else 0.0
        code_bonus = 0.20 if any(any(ch.isdigit() for ch in t) for t in matched) else 0.0
        fscore = min(0.62 + ratio * 0.30 + exact_bonus + code_bonus, 0.98)
        if any(any(ch.isdigit() for ch in t) and len(t) >= 4 for t in matched):
            fscore = max(fscore, 0.90)
        file_rank.append((src, fscore, chunks, matched))

    file_rank.sort(key=lambda x: x[1], reverse=True)
    results = []
    for src, fscore, chunks, matched in file_rank[:max(top_files, 1)]:
        scored_chunks = []
        for ch in chunks:
            txt_l = ch.get("text", "").lower()
            t_hits = sum(1 for t in clean_terms if len(t) >= 3 and t in txt_l)
            cscore = min(fscore + min(t_hits, 4) * 0.05, 0.99)
            scored_chunks.append((cscore, t_hits, ch))
        scored_chunks.sort(key=lambda x: (x[0], x[1]), reverse=True)

        for cscore, _, ch in scored_chunks[:max(chunks_per_file, 1)]:
            results.append({
                **ch,
                "score": cscore,
                "vector_score": 0.0,
                "bm25_score": 0.0,
                "keyword_score": cscore,
                "_filename_kw": True,
                "_fname_terms": matched[:3],
            })

    return results


def semantic_search(store, query: str, top_k: int = 20) -> list:
    if not store or not getattr(store, "faiss_idx", None) or not getattr(store, "chunks", None):
        return []

    cand_k = min(max(top_k * 10, 80), len(store.chunks))
    qe = store.engine.encode([query], is_query=True)
    vs, vi = store.faiss_idx.search(qe, cand_k)
    vmx = max(float(vs[0][0]), 1e-9)

    out = []
    for sc, idx in zip(vs[0], vi[0]):
        if idx < 0:
            continue
        v = float(sc) / vmx
        ch = dict(store.chunks[int(idx)])
        ch.update({
            "score": v,
            "vector_score": v,
            "bm25_score": 0.0,
            "keyword_score": 0.0,
            "_semantic": True,
            "_semantic_model": SEMANTIC_REFERENCE_MODEL,
        })
        out.append(ch)

    return out[:max(top_k, 1)]


def _ollama_keyword_match_search(store, query: str, expansions: list,
                                 ollama_kws: list, limit: int = 80) -> list:
    if not store or not getattr(store, "chunks", None) or not ollama_kws:
        return []

    stop = _FNAME_STOP
    terms, seen = [], set()
    for kw in ollama_kws[:12]:
        kl = str(kw).lower().strip()
        if len(kl) >= 3 and kl not in stop and kl not in seen:
            seen.add(kl)
            terms.append(kl)
        compact = re.sub(r"[^\w]+", "", kl, flags=re.UNICODE)
        if len(compact) >= 3 and compact not in stop and compact not in seen:
            seen.add(compact)
            terms.append(compact)

    ranked = []
    for ch in store.chunks:
        txt_l = ch.get("text", "").lower()
        if not txt_l:
            continue
        hits = [t for t in terms if t in txt_l]
        if not hits:
            continue

        rel = _file_relevance_score(ch, query, expansions)
        base = min(0.40 + (len(hits) - 1) * 0.10 + rel * 0.20, 0.98)
        ranked.append({
            **ch,
            "score": base,
            "vector_score": 0.0,
            "bm25_score": 0.0,
            "keyword_score": min(len(hits) / max(len(terms), 1) * 2.0, 1.0),
            "_file_rel": rel,
            "_ollama_kw_direct": hits[:4],
        })

    ranked.sort(key=lambda x: (x["score"], len(x.get("_ollama_kw_direct", []))), reverse=True)
    return ranked[:max(limit, 1)]


# ── Table-first retrieval ────────────────────────────────────
_TABLE_MD_SEP_RE = re.compile(r"^\s*\|?\s*:?-{2,}:?\s*(\|\s*:?-{2,}:?\s*)+\|?\s*$")
_TABLE_SEPS      = re.compile(r"[\|	,;;　]")


def _tbl_query_tokens(query: str) -> list:
    STOP = {
        "вэ","бэ","юу","яу","гэж","гэх","нь","ын","ийн","бол","байна",
        "дэх","дотор","миний","минь","надад","би",
        "the","is","a","of","and","in","to","for","with","on","at","by","an",
        "my","what","how","when","where","who","which","i","me","am","are",
    }
    return [t for t in re.findall(r"\w+", query.lower(), re.UNICODE)
            if len(t) >= 2 and t not in STOP]


def _tbl_is_structured(line: str) -> bool:
    ln = (line or "").strip()
    if not ln:
        return False
    if _TABLE_MD_SEP_RE.match(ln):
        return True
    if _TABLE_SEPS.search(ln):
        return True
    if re.search(r"\w.{0,30}[:=]\s*\S", ln):
        return True
    return False


def _tbl_split_cells(line: str) -> list:
    ln = (line or "").strip()
    if not ln:
        return []
    for sep in ("|", "	", ",", ";"):
        parts = ln.strip(sep).split(sep)
        if len(parts) >= 2:
            return [p.strip() for p in parts if p.strip()]
    m = re.match(r"^(.{1,40}?)\s*[:=]\s*(.+)$", ln)
    if m:
        return [m.group(1).strip(), m.group(2).strip()]
    return []


def _tbl_read_raw(path: str) -> str:
    p = Path(path)
    if not p.exists() or not p.is_file():
        return ""
    if p.suffix.lower() in {".csv", ".tsv", ".txt", ".md", ".log", ".rst"}:
        for enc in ["utf-8", "utf-16", "cp1251", "latin-1"]:
            try:
                return p.read_text(encoding=enc)
            except Exception:
                continue
    reader = READERS.get(p.suffix.lower())
    if not reader:
        return ""
    try:
        return reader(str(p)) or ""
    except Exception:
        return ""


def _tbl_score_file(source: str, path: str, raw: str,
                    q_tokens: list, line_window: int = 8):
    if not raw or not q_tokens or len(raw.strip()) < 20:
        return None

    lines = [ln.strip() for ln in raw[:200000].splitlines() if ln.strip()]
    if not lines:
        return None

    kw_idx = [i for i, ln in enumerate(lines)
               if any(tok in ln.lower() for tok in q_tokens)]
    if not kw_idx:
        return None

    struct_set = {i for i, ln in enumerate(lines) if _tbl_is_structured(ln)}
    best_snip  = None
    best_kv    = None
    best_val   = None
    win_hits   = 0
    kv_hits    = 0

    for ki in kw_idx:
        lo = max(0, ki - line_window)
        hi = min(len(lines) - 1, ki + line_window)

        has_struct = any(j in struct_set for j in range(lo, hi + 1))
        if not has_struct:
            if not re.search(r"\w.{0,30}[:=]\s*\S", lines[ki]):
                continue

        win_hits += 1
        if best_snip is None:
            best_snip = "\n".join(lines[lo:hi + 1])

        for j in range(lo, hi + 1):
            cells = _tbl_split_cells(lines[j])
            if len(cells) < 2:
                continue
            for ci, cell in enumerate(cells):
                if not any(tok in cell.lower() for tok in q_tokens):
                    continue
                for nx in cells[ci + 1:ci + 3]:
                    if len(nx.strip()) >= 1:
                        kv_hits += 1
                        if best_kv is None:
                            best_kv  = f"{cell}→{nx}"
                            best_val = nx
                        break

    if win_hits == 0:
        return None

    score = 0.72 + min(win_hits * 0.15, 0.30) + min(kv_hits * 0.18, 0.36)

    return {
        "source":           source,
        "path":             path,
        "text":             (best_snip or "")[:1800],
        "score":            min(score, 1.85),
        "vector_score":     0.0,
        "bm25_score":       0.0,
        "keyword_score":    1.0,
        "_table_candidate": True,
        "_table_kv":        best_kv or f"{q_tokens[0]}|?",
        "_table_value":     best_val or "",
        "_table_wins":      win_hits,
        "_table_kvhits":    kv_hits,
    }


def _table_first_retrieval(store, query: str, max_tables: int = 10,
                            line_window: int = 8) -> list:
    if not store or not getattr(store, "chunks", None):
        return []

    q_tokens = _tbl_query_tokens(query)
    if not q_tokens:
        return []

    file_map: dict = {}
    for ch in store.chunks:
        p = ch.get("path")
        if not p or p in file_map:
            continue
        file_map[p] = ch.get("source", Path(p).name)

    candidates = []
    for path, source in file_map.items():
        raw  = _tbl_read_raw(path)
        cand = _tbl_score_file(source, path, raw,
                               q_tokens=q_tokens, line_window=line_window)
        if cand:
            candidates.append(cand)

    candidates.sort(key=lambda x: x.get("score", 0.0), reverse=True)
    return candidates[:max(1, max_tables)]


def _llm_table_rerank(model: str, query: str, candidates: list):
    meta = {}
    if not candidates or not model or model == "(олдсонгүй)" or not _ollama_ping():
        return candidates, meta

    top  = candidates[:8]
    rows = []
    for i, c in enumerate(top, 1):
        sn = c.get("text", "").replace("\n", " ")[:280]
        rows.append(f"[{i}] file={c.get('source','?')} "
                    f"kv={c.get('_table_kv','?')} | {sn}")

    prompt = (
        f"Question: {query}\n\n"
        "Pick the ONE snippet most clearly answering the question.\n"
        "Return JSON only:\n"
        '{"best_index":1,"confidence":0.9,"answer":"value","has_answer":true}\n\n'
        "Snippets:\n" + "\n".join(rows)
    )

    out = _ollama_call_simple(model, prompt, timeout=15)
    if not out:
        return candidates, meta

    try:
        m = re.search(r"\{[\s\S]*?\}", out)
        if not m:
            return candidates, meta
        data    = json.loads(m.group())
        bi      = int(data.get("best_index", 0))
        conf    = float(data.get("confidence", 0.0))
        answer  = str(data.get("answer", "")).strip()
        has_ans = bool(data.get("has_answer", False))
    except Exception:
        return candidates, meta

    if bi < 1 or bi > len(top):
        return candidates, meta

    reranked = []
    for i, c in enumerate(top, 1):
        cc = dict(c)
        if i == bi:
            cc["score"]      = min(cc.get("score", 0.0) + max(conf, 0.2) * 0.35, 1.95)
            cc["_table_llm"] = True
            if answer:
                cc["_table_answer"] = answer
        else:
            cc["score"] = cc.get("score", 0.0) * 0.75
        reranked.append(cc)

    reranked.sort(key=lambda x: x.get("score", 0.0), reverse=True)
    meta["table_best"]   = reranked[0].get("source", "?")
    meta["table_answer"] = reranked[0].get("_table_answer", "") if has_ans else ""
    return reranked + candidates[8:], meta


