def _detect_device():
    try:
        import torch
        if torch.cuda.is_available():
            name  = torch.cuda.get_device_name(0)
            total = torch.cuda.get_device_properties(0).total_memory / (1024**3)
            print(f"  GPU: {name} ({total:.1f}GB VRAM)")
            return torch.device("cuda"), "cuda", total
        if hasattr(torch.backends, "mps") and torch.backends.mps.is_available():
            print("  GPU: Apple MPS")
            return torch.device("mps"), "mps", 0.0
        ver = getattr(torch.version, "cuda", None)
        is_cpu_build = "+cpu" in torch.__version__ or ver is None
        if is_cpu_build:
            print(f"  ⚠️  CPU-only torch ({torch.__version__}) суусан байна.")
            print(f"  GPU ашиглахын тулд:")
            print(f"  {_TORCH_CUDA_INSTALL}")
        else:
            print(f"  CUDA={ver} байгаа ч GPU олдсонгүй — driver шалгана уу.")
    except ImportError:
        print("  torch суулгаагүй → pip install torch")
    print("  CPU горимд ажиллана")
    return None, "cpu", 0.0

_DEVICE, _DEVICE_TYPE, _VRAM_GB = _detect_device()

def _gpu_batch(bs):
    if _DEVICE_TYPE == "cpu":  return bs
    if _DEVICE_TYPE == "mps":  return min(bs*4, 512)
    if _VRAM_GB >= 16:         return min(bs*8, 1024)
    if _VRAM_GB >= 8:          return min(bs*4, 512)
    if _VRAM_GB >= 4:          return min(bs*2, 256)
    return bs

def _gpu_str():
    if _DEVICE_TYPE == "cuda": return f"CUDA ({_VRAM_GB:.1f}GB)"
    if _DEVICE_TYPE == "mps":  return "Apple MPS"
    return "CPU"

def _cpu_info():
    cores = os.cpu_count() or 4
    try:
        import psutil; ram = psutil.virtual_memory().total / (1024**3)
    except ImportError: ram = 8.0
    return cores, ram

def _opt_batch():
    _, ram = _cpu_info()
    if ram < 8:  return 8
    if ram < 16: return 16
    if ram < 32: return 32
    return 64

def _opt_threads():
    cores, _ = _cpu_info()
    return max(1, min(cores//2, 4))

