def _read_one(fp):
    fp = Path(fp)
    ext = fp.suffix.lower()
    if ext in SKIP_EXTENSIONS: return {"skip":True,"reason":"кодын файл","name":fp.name}
    if ext not in READERS:     return {"skip":True,"reason":f"дэмжигдэхгүй ({ext})","name":fp.name}
    try:
        sz = fp.stat().st_size
        if sz == 0: return {"skip":True,"reason":"хоосон","name":fp.name}
        if sz > MAX_FILE_MB*1024*1024: return {"skip":True,"reason":f"том ({sz//1024//1024}MB)","name":fp.name}
        t0 = time.perf_counter()
        txt = (READERS[ext](str(fp)) or "").strip()
        elapsed = time.perf_counter() - t0
        if elapsed > 5.0:
            print(f"  ⚠️ УДААН: {fp.name} — {elapsed:.1f}с ({sz//1024}KB)")
        if not txt:
            r = "PDF: текст олдсонгүй" if ext==".pdf" else "хоосон агуулга"
            return {"skip":True,"reason":r,"name":fp.name}
        if len(txt) < MIN_CHUNK_LEN: return {"skip":True,"reason":f"богино ({len(txt)}с)","name":fp.name}
        normalized_name = _normalize_filename(fp.name)
        return {"path":str(fp),"name":normalized_name,"text":txt,
                "size":len(txt),"hash":_file_hash(str(fp))}
    except PermissionError: return {"skip":True,"reason":"эрх байхгүй","name":fp.name}
    except Exception as e:  return {"skip":True,"reason":str(e)[:80],"name":fp.name}

def _should_skip_file(fp: Path) -> str:
    name = fp.name
    name_l = name.lower()

    for prefix in SKIP_FILENAME_PREFIXES:
        if name.startswith(prefix):
            return f"recycle/temp ({prefix})"

    for pat in SKIP_FILENAME_CONTAINS:
        if pat in name:
            return f"template/test ({pat})"

    if re.match(r'^[A-Z][a-zA-Z]+\.[a-z]+[A-Z]', name):
        return "test fixture (CamelCase.method)"

    if (fp.suffix.lower() in {'.txt', '.rst'} and
        '_' in name_l and
        fp.stat().st_size < 5120 and
        re.match(r'^[a-z][a-z0-9_]+\.(txt|rst)$', name_l) and
        any(kw in name_l for kw in [
            'invalid_', 'missing_', 'deprecated_', 'duplicate_',
            'broad_', 'bad_', 'logging_', 'implicit_', 'inconsistent_',
            'generic_alias', 'consider_', 'unnecessary_', 'assignment_',
        ])):
        return "linter test data"

    if re.match(r'^(bom_|test-|test_)', name_l) and fp.stat().st_size < 5120:
        return "encoding test"

    return ""


def load_documents(folder, progress=None):
    folder = folder.strip().strip('"\'')
    fp = Path(folder)
    if not fp.exists(): return [], [f"Фолдер олдсонгүй: {folder}"]
    _ignore_lower = {d.lower() for d in IGNORE_DIRS}
    files = [f for f in fp.rglob("*")
             if f.is_file()
             and not any(p.name.lower() in _ignore_lower for p in f.parents)
             and f.suffix.lower() not in SKIP_EXTENSIONS
             and f.suffix.lower() in READERS]
    if not files:
        exts = {f.suffix.lower() for f in fp.rglob("*") if f.is_file()}
        return [], [f"Файл байхгүй. Өргөтгөлүүд: {', '.join(sorted(exts)[:10])}"]

    filtered, auto_skipped = [], []
    for f in files:
        reason = _should_skip_file(f)
        if reason:
            auto_skipped.append(f"{f.name} — {reason}")
        else:
            filtered.append(f)

    if auto_skipped:
        print(f"  🔍 Автомат шүүлт: {len(auto_skipped)} test/fixture файл алгасагдлаа")
        if len(auto_skipped) <= 10:
