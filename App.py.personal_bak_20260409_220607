def self_reflect_search(store, model: str, question: str,
                        results: list, top_k: int) -> list:
    if not results or not _ollama_ping():
        return results

    ctx_preview = "\n".join(
        f"[{i+1}] {r.get('source','?')}: {r['text'][:180].replace(chr(10),' ')}"
        for i, r in enumerate(results[:4])
    )
    reflect_prompt = (
        f"Question: {question}\n\n"
        f"Retrieved {len(results)} document chunks. Preview:\n{ctx_preview}\n\n"
        "Do these chunks contain enough information to fully answer the question? "
        "Answer ONLY 'YES' or 'NO':"
    )
    verdict = _ollama_call_simple(model, reflect_prompt, timeout=8).upper()

    if "YES" in verdict:
        return results

    refine_prompt = (
        f"The search for '{question}' returned insufficient results.\n"
        "Write ONE alternative search query using different keywords "
        "(output ONLY the query, no explanation):"
    )
    new_q = _ollama_call_simple(model, refine_prompt, timeout=8).strip().strip('"\'')
    if not new_q or len(new_q) < 4 or new_q.lower() == question.lower():
        return results

    try:
        extra, _ = enhanced_search_pipeline(store, new_q, model, top_k, False, False)
        seen = {_chunk_key(r) for r in results}
        added = 0
        for c in extra:
            if _chunk_key(c) not in seen:
                c = dict(c)
                c["score"] *= 0.85
                c["_self_rag"] = True
                c["_self_rag_q"] = new_q[:60]
                results.append(c)
                seen.add(_chunk_key(c))
                added += 1
        if added:
            results.sort(key=lambda x: x["score"], reverse=True)
    except Exception:
        pass

    return results[:top_k + 3]


def summarize_chunks_for_context(model: str, chunks: list,
                                  question: str, max_raw_len: int = 1200) -> str:
    ollama_ok = _ollama_ping()
    parts = []

    for i, r in enumerate(chunks, 1):
        src  = r.get("source", "?")
        text = r.get("text", "").strip()

        if ollama_ok and len(text) > max_raw_len:
            sum_prompt = (
                f"Summarize the following document excerpt in 3-5 sentences, "
                f"focusing ONLY on information relevant to: '{question}'\n"
                "Output ONLY the summary, no preamble.\n\n"
                f"{text[:2500]}"
            )
            summary = _ollama_call_simple(model, sum_prompt, timeout=12)
            if summary and len(summary.strip()) > 30:
                text = f"[Summary] {summary.strip()}"
            else:
                text = text[:max_raw_len]

        parts.append(f"[{i}] Source: {src}\n{text}")

    return "\n\n---\n\n".join(parts)


def multi_step_search(store, question: str, rewritten: str,
                      top_k: int, use_reranker: bool, debug: bool) -> list:
    r1 = store.search(question, top_k=top_k, use_reranker=False, debug=debug)

    r2 = []
    if rewritten.lower() != question.lower():
        r2 = store.search(rewritten, top_k=top_k, use_reranker=False, debug=False)

    seen   = {c["text"][:80] for c in r1}
    merged = list(r1)
    for c in r2:
        if c["text"][:80] not in seen:
            seen.add(c["text"][:80])
            c = dict(c); c["score"] *= 0.9; c["_r2"] = True
            merged.append(c)

    merged.sort(key=lambda x: x["score"], reverse=True)

    if use_reranker and store.reranker.available and len(merged) > 1:
        q_ascii = sum(1 for ch in question if ord(ch) < 128) / max(len(question), 1)
        if q_ascii > 0.7:
            merged = store.reranker.rerank(question, merged, top_k)
            return merged

    return merged[:top_k]


