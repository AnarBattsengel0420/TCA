        kw      = " 🔑" if (r.get("_kw") or r.get("_kw_fallback") or r.get("_filename_kw")) else ""

        if confidence >= CONFIDENCE_THRESHOLD:
            conf_icon = "✅"
        elif confidence >= 0.5:
            conf_icon = "🟡"
        else:
            conf_icon = "⚪"

        preview = txt[:plen].replace("\n"," ").strip() + ("…" if len(txt)>plen else "")
        rel_str = f" rel={r.get('_rel',0):.2f}" if r.get('_rel') else ""

        if debug_mode:
            extra_tags = []
            if r.get("_table"):
                kv = r.get("_table_kv","")[:20]
                extra_tags.append(f"📋tbl" + (f":{kv}" if kv else ""))
            if r.get("_table_llm"):   extra_tags.append("🤖tbl-llm")
            if r.get("_enhanced"): extra_tags.append("boost")
            if r.get("_synonym"):  extra_tags.append("syn")
            if r.get("_filename_kw"): extra_tags.append("fname-kw")
            if r.get("_semantic"):    extra_tags.append("sem")
            if r.get("_personal_boost"): extra_tags.append("👤personal")
            if r.get("_ollama_kw_direct"):
                extra_tags.append(f"okw:{len(r.get('_ollama_kw_direct', []))}")
            if r.get("_kw_fallback"):
                extra_tags.append(f"kw:{str(r['_kw_fallback'])[:10]}")
            if r.get("_subquery"): extra_tags.append(f"sq:{r['_subquery'][:15]}")
            if r.get("_forced"):   extra_tags.append(f"📌fname{r.get('_file_rel',0):.1f}")
            elif r.get("_file_rel", r.get("_rel", 0)) >= 0.5:
                extra_tags.append(f"fn={r.get('_file_rel', r.get('_rel',0)):.1f}")
            tags_str = f" [{','.join(extra_tags)}]" if extra_tags else ""

            chunks_block += (f"\n**[{i}] {src}**{kw} {conf_icon}{tags_str}\n"
                             f"_s={score:.3f} conf={confidence:.2f} v={r.get('vector_score',0):.2f} "
                             f"b={r.get('bm25_score',0):.2f} kw={r.get('keyword_score',0):.2f}{rel_str}_\n")
        else:
            chunks_block += f"\n**[{i}] {src}**{kw} {conf_icon} _(оноо: {score:.2f})_\n"
        chunks_block += f"```\n{preview}\n```\n"

    initial = exp_block + ranking_block + pattern_block + chunks_block + trace_block
    history = _chat_append(history, question, initial)
    yield history

    if not model or model == "(олдсонгүй)": return

    ctx_parts = []
    for i, r in enumerate(results, 1):
        src = r.get("source", "?")
        text = r.get("text", "").strip()[:1500]
        ctx_parts.append(f"[{i}] Source: {src}\n{text}")
    ctx = "\n\n---\n\n".join(ctx_parts)

    ollama_ans, started = "", False
    for tok in ask_stream(model, question, ctx):
        if not started:
            started = True
            history = _chat_update_last(history, initial+"\n---\n**🤖 AI хариулт:**\n")
            yield history
        ollama_ans += tok
        history = _chat_update_last(history, initial+"\n---\n**🤖 AI хариулт:**\n"+ollama_ans)
        yield history
    if not started:
        history = _chat_update_last(history, initial+"\n---\n_Ollama хариулаагүй._")
        yield history


# ── Файл оношлогоо ───────────────────────────────────────────
def diagnose_file(filename_pat: str, test_query: str) -> str:
    if store is None:
        return "⚠️ Индекс ачаалагдаагүй. Эхлээд ачааллана уу."
    pat = (filename_pat or "").strip()
    if not pat:
        return "⚠️ Файлын нэрийн хэсэг оруулна уу."

    pat_l   = _normalize_filename(pat).lower()
    matched = [ch for ch in store.chunks
               if pat_l in _normalize_filename(ch.get("source","")).lower()]

    lines = [f"## 🔬 Файл оношлогоо: `{pat}`\n"]
    if not matched:
        lines.append(f"❌ **'{pat}' нэртэй файл индексэд байхгүй.**\n")
        lines.append("**Бүх файлын жагсаалт:**")
        for s in sorted({ch.get("source","?") for ch in store.chunks}):
            lines.append(f"  - `{s}`")
        return "\n".join(lines)

    srcs = sorted({ch.get("source","?") for ch in matched})
    lines.append(f"✅ **{len(matched)} chunk** | {len(srcs)} файл:")
    for s in srcs:
        n = sum(1 for ch in matched if ch.get("source") == s)
        lines.append(f"  - `{s}` ({n} chunk)")
    lines.append(f"\n**Нийт индексэд:** {len(store.chunks):,} chunk\n")

    query = (test_query or "").strip()
    tbl_query = query or pat
    tbl_hits = _table_first_retrieval(store, tbl_query, max_tables=5)
    tbl_match = [c for c in tbl_hits
                 if pat_l in _normalize_filename(c.get("source","")).lower()]
    if tbl_match:
        lines.append(f"**📋 Table detection:** ✅ `{tbl_match[0].get('source','')}` | "
                     f"score={tbl_match[0]['score']:.2f} | "
                     f"kv=`{tbl_match[0].get('_table_kv','')[:50]}`\n")
    else:
        lines.append(f"**📋 Table detection:** ❌ '{pat}' файл table scan-д олдсонгүй\n")

    if not query:
        lines.append("💡 **Test query оруулбал оноо харагдана.**")
        lines.append("\n**Chunk preview (эхний 5):**")
        for i, ch in enumerate(matched[:5], 1):
            p = ch["text"][:150].replace("\n"," ")
            lines.append(f"\n**[{i}]** `{ch.get('source','?')}`\n```\n{p}…\n```")
        return "\n".join(lines)

    qe = store.engine.encode([query], is_query=True)
    vs, vi = store.faiss_idx.search(qe, min(len(store.chunks), 300))
    vmx = max(float(vs[0][0]), 1e-9)
    vec_map = {int(i): float(s)/vmx for s,i in zip(vs[0],vi[0]) if i >= 0}
    ch2i = {id(ch): i for i, ch in enumerate(store.chunks)}

    bm25_map: dict = {}
    for bq in _build_bm25_queries(query, expand_query(query)):
        for idx, sc in store.bm25.search(bq, top_k=len(store.chunks)):
            bm25_map[idx] = max(bm25_map.get(idx, 0.0), sc)
    bm25_mx = max(bm25_map.values(), default=1e-9)

    w = WEIGHT_PROFILES.get(classify_query_type(query), WEIGHT_PROFILES["mixed"])
    lines.append(f"**Query:** `{query}` | type=`{classify_query_type(query)}` | "
                 f"bm25={w['bm25']:.2f} vec={w['vector']:.2f} kw={w['keyword']:.2f}\n")
    lines.append("```")
    lines.append(f"{'#':<3} {'Vec':>6} {'BM25':>6} {'KW':>6} {'Score':>7}  Preview")
    lines.append("─"*72)

    scored = []
    for ch in matched:
        idx = ch2i.get(id(ch), -1)
        v  = vec_map.get(idx, 0.0)
        b  = bm25_map.get(idx, 0.0) / bm25_mx
        tl = ch["text"].lower()
        ql = query.lower()
        ws = [x for x in re.findall(r'\w+', ql, re.UNICODE) if len(x) > 2]
        kw = 1.0 if ql in tl else (sum(1 for x in ws if x in tl)/len(ws) if ws else 0.0)
        sc = w["vector"]*v + w["bm25"]*b + w["keyword"]*kw
        scored.append((sc, v, b, kw, ch))

    scored.sort(reverse=True)
    for i, (sc, v, b, kw, ch) in enumerate(scored[:8], 1):
        prev = ch["text"][:55].replace("\n"," ")
        lines.append(f"{i:<3} {v:>6.3f} {b:>6.3f} {kw:>6.3f} {sc:>7.3f}  {prev}…")
    lines.append("```")

    if scored:
        all_fs = _score_all_files(store, query, expand_query(query))
        rank   = next((i for i,(src,*_) in enumerate(all_fs,1)
                       if pat_l in _normalize_filename(src).lower()), None)
        lines.append(f"\n**Бүх файл дунд rank:** "
                     f"{'**#'+str(rank)+'**' if rank else '?'} | "
                     f"best chunk score={scored[0][0]:.3f}")
        if rank and rank > 3:
            lines.append("⚠️ Rank доогуур — query өөрчилж үзнэ үү.")
        elif rank and rank <= 3:
            lines.append("✅ Rank өндөр — зөв ажиллаж байна.")
    return "\n".join(lines)


def run_diagnose(pat, query):
    return diagnose_file(pat, query)


