def _normalize_filename(name: str) -> str:
    """Normalize Unicode filename to NFC form for consistent matching."""
    return unicodedata.normalize("NFC", name) if name else name

def _normalize_path(p) -> Path:
    """Normalize a Path's filename component to NFC Unicode."""
    p = Path(p)
    normalized_name = _normalize_filename(p.name)
    if normalized_name != p.name:
        return p.parent / normalized_name if not p.exists() else p
    return p


